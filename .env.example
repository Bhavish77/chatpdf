GEMINI_API_KEY=
GEN_MODEL=gemini-3.5-flash
HELPER_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
# Neon DIRECT (non-pooled) connection string in production, or the local docker one below.
DATABASE_URL=postgresql://askdocs:askdocs@localhost:5432/askdocs
# true on Render free: run the worker inside the API process instead of as a separate one.
EMBEDDED_WORKER=false
WORKER_CONCURRENCY=1
EMBED_BATCH_SIZE=32
# Tune from your AI Studio rate limits (aistudio.google.com/rate-limit).
EMBED_MIN_INTERVAL_S=0.7
LLM_MAX_CONCURRENCY=3
RETRIEVAL_K=8
GRADE_MIN_RELEVANT=2
ENABLE_GROUNDING_CHECK=true

# Auth
# false only for local http://localhost (docker-compose sets this itself).
COOKIE_SECURE=true
# e.g. https://askdocs.onrender.com ; empty = use the request host.
PUBLIC_ORIGIN=
SESSION_TTL_DAYS=7
SIGNUPS_ENABLED=true
# empty = open signup
SIGNUP_INVITE_CODE=
# per IP
SIGNUP_RATE_PER_HOUR=5
# per email+IP per 15 minutes
LOGIN_MAX_FAILURES=5

# Limits and retention
MAX_FILE_MB=15
MAX_PAGES=200
MAX_CHUNKS_PER_DOC=1500
MAX_DOCS_PER_USER=10
MAX_USER_STORAGE_MB=50
MAX_TOTAL_STORAGE_MB=400
USER_CHAT_PER_DAY=100
CHAT_RATE_PER_MIN=15
UPLOAD_RATE_PER_HOUR=20
# 0 = keep until the user deletes
DOC_TTL_DAYS=7
ACCOUNT_TTL_DAYS=30
# true on Render
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO
